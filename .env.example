# Cloud Run runtime
HOST=0.0.0.0
PORT=8080
BOT_EXECUTION_ENABLED=false
TIMEZONE=Asia/Dhaka

# Bybit Demo only
BYBIT_BASE_URL=https://api-demo.bybit.com
BYBIT_API_KEY=replace-with-secret-manager-reference
BYBIT_API_SECRET=replace-with-secret-manager-reference

# Privileged backend API authentication
ADMIN_TOKEN=replace-with-random-32-plus-character-secret

# Persistent PostgreSQL runtime state
DATABASE_URL=postgresql://user:password@host:5432/database
RUNTIME_LEADER_LOCK_ID=742026073001

# Frontend and service URLs
CORS_ALLOWED_ORIGINS=https://your-vercel-app.vercel.app
PUBLIC_BASE_URL=https://your-cloud-run-service-url
