# Cloud Run runtime
HOST=0.0.0.0
PORT=8080
BOT_EXECUTION_ENABLED=false
TIMEZONE=Asia/Dhaka

# Bybit Demo only
BYBIT_BASE_URL=https://api-demo.bybit.com
BYBIT_API_KEY=replace-with-secret-manager-reference
BYBIT_API_SECRET=replace-with-secret-manager-reference

# Privileged backend API authentication
ADMIN_TOKEN=replace-with-random-32-plus-character-secret

# Persistent PostgreSQL runtime state (support/reconciliation, not execution eligibility)
DATABASE_URL=postgresql://user:password@host:5432/database
RUNTIME_LEADER_LOCK_ID=742026073001

# Frontend and service URLs
CORS_ALLOWED_ORIGINS=https://your-vercel-app.vercel.app
PUBLIC_BASE_URL=https://your-cloud-run-service-url

# Canonical closed-1H watchlist
HOURLY_WATCHLIST_SIZE=50

# Python -> Node internal direct handoff
NODE_EXECUTION_URL=https://your-node-execution-cloud-run-service
NODE_HANDOFF_TOKEN=replace-with-shared-random-secret
NODE_HANDOFF_TIMEOUT_SECONDS=5

# Node Demo auto-execution
NODE_EXECUTION_OWNER_ID=bybit-node-execution-1
NODE_EXECUTION_ENABLED=true
FIRST_DEMO_TRADE_ARMED=true
MAX_ACTIVE_TRADES=3
NODE_STRUCTURE_LOOKBACK_15M=12
# NODE_HANDOFF_TOKEN must match the Python/backend value above.
# DATABASE_URL is optional for Node direct intake; when unavailable PostgreSQL
# support is DEGRADED and cold-start orphan ownership remains fail-closed.
