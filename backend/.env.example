BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_BASE_URL=https://api-demo.bybit.com
ADMIN_TOKEN=replace-with-a-strong-random-token
CORS_ALLOWED_ORIGINS=
PUBLIC_BASE_URL=
TIMEZONE=Asia/Dhaka
# Mandatory restart-safe database. Automatic execution is blocked when unavailable.
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
PORT=8787
MAX_OPEN_POSITIONS=3

# Serial 6 — Liquid Intraday Top Movers
UNIVERSE_SHORTLIST_SIZE=20
MAX_SCAN_SYMBOLS=10
NORMAL_SPREAD_PCT=0.08
REDUCED_SIZE_SPREAD_PCT=0.15
MAX_SPREAD_PCT=0.20
MIN_TURNOVER_24H=10000000
MIN_LAST_PRICE=0.01
MAX_ABS_CHANGE_PCT=15
MIN_ATR_15M_PCT=0.25
MAX_ATR_15M_PCT=3.00
MIN_RECENT_VOLUME_RATIO=1.20
MIN_GROSS_RR=2.00
MIN_NET_RR=1.70
PREFERRED_NET_RR=2.00
NORMAL_ENTRY_COST_RISK_PCT=15
MAX_ENTRY_COST_RISK_PCT=35
UNIVERSE_REFRESH_SECONDS=600
SCAN_INTERVAL_SECONDS=30
SCAN_DEADLINE_SECONDS=20
ESTIMATED_TAKER_FEE_PCT=0.055
SLIPPAGE_SPREAD_MULTIPLIER=0.50
